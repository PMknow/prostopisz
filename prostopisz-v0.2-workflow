app:
  description: 'Wieloagentowy asystent analityczny wspierający organizacje pozarządowe
    (NGO) i wnioskodawców w natychmiastowej ekstrakcji danych, zarządzaniu ryzykiem
    formalnym oraz analizie regulaminów grantowych. Wersja testowa - może popełniać
    błędy. '
  icon: 🤖
  icon_background: '#FEF7C3'
  icon_type: emoji
  mode: workflow
  name: Prostopisz v0.2 - checklista grantowa
  use_icon_as_answer_icon: false
